# Copy to .env for local development:  cp .env.example .env
#
# Vite only exposes vars prefixed with VITE_, and inlines them at BUILD time.
# Changing this value requires a rebuild/redeploy — it is not read at runtime.

# Backend base URL. Omit to use the live Render deployment
# (https://social-sentinel-api.onrender.com), which is the built-in default.
# Point it at a local backend while working on the API:
VITE_BACKEND_URL=http://localhost:5000
